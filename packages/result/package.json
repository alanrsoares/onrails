{
  "name": "@onrails/result",
  "version": "0.4.0",
  "description": "Tagged Result / ResultAsync for railway-oriented TypeScript \u2014 pure tagged unions, neverthrow-shaped compat shim, FL-friendly",
  "license": "MIT",
  "author": "Alan R. Soares",
  "homepage": "https://alanrsoares.github.io/onrails/modules/_onrails_result.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanrsoares/onrails.git",
    "directory": "packages/result"
  },
  "bugs": {
    "url": "https://github.com/alanrsoares/onrails/issues"
  },
  "keywords": [
    "result",
    "neverthrow",
    "tagged-union",
    "discriminated-union",
    "either",
    "maybe",
    "railway-oriented-programming",
    "rop",
    "typescript",
    "bun",
    "functional",
    "tanstack-intent"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "DESIGN.md",
    "README.md",
    "RECIPES.md",
    "LICENSE",
    "skills"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fluent": {
      "import": {
        "types": "./dist/fluent.d.ts",
        "default": "./dist/fluent.js"
      },
      "require": {
        "types": "./dist/fluent.d.cts",
        "default": "./dist/fluent.cjs"
      }
    },
    "./async": {
      "import": {
        "types": "./dist/async-fns.d.ts",
        "default": "./dist/async-fns.js"
      },
      "require": {
        "types": "./dist/async-fns.d.cts",
        "default": "./dist/async-fns.cjs"
      }
    },
    "./extra": {
      "import": {
        "types": "./dist/extra.d.ts",
        "default": "./dist/extra.js"
      },
      "require": {
        "types": "./dist/extra.d.cts",
        "default": "./dist/extra.cjs"
      }
    },
    "./pipe": {
      "import": {
        "types": "./dist/pipe.d.ts",
        "default": "./dist/pipe.js"
      },
      "require": {
        "types": "./dist/pipe.d.cts",
        "default": "./dist/pipe.cjs"
      }
    },
    "./railway": {
      "import": {
        "types": "./dist/railway.d.ts",
        "default": "./dist/railway.js"
      },
      "require": {
        "types": "./dist/railway.d.cts",
        "default": "./dist/railway.cjs"
      }
    },
    "./try-gen": {
      "import": {
        "types": "./dist/try-gen.d.ts",
        "default": "./dist/try-gen.js"
      },
      "require": {
        "types": "./dist/try-gen.d.cts",
        "default": "./dist/try-gen.cjs"
      }
    },
    "./compat/neverthrow": {
      "import": {
        "types": "./dist/compat/neverthrow.d.ts",
        "default": "./dist/compat/neverthrow.js"
      },
      "require": {
        "types": "./dist/compat/neverthrow.d.cts",
        "default": "./dist/compat/neverthrow.cjs"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun typecheck && bun test",
    "build": "tsup && tsc -p tsconfig.build.json && bun run ../../scripts/dts-to-cts.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "ts-expect": "catalog:",
    "tsup": "catalog:"
  }
}
