// @onrails/biome-plugin: no-deprecated-synonyms
//
// Flag deprecated railway/maybe synonyms. Use canonical versions instead:
// - chain() -> flatMap() / andThen()
// - getOrElse() -> unwrapOr()
// - of() -> ok() / some()
// - fold() / matchResult() / matchMaybe() -> match()
// - sequenceTupleAsync() -> ResultAsync.combineTuple()
// - collect() -> combine()
// - ResultAsync.isOk() / isErr() -> await and narrow with isOk() / isErr()
//
// Scoping: only files that mention an `@onrails/*` module source are matched,
// so same-named calls from other libraries (RxJS `of`, fp-ts `fold`) are left
// alone. The ESLint rule is name-based everywhere; declared in
// ENGINE_DIVERGENCES (`no-deprecated-synonyms` / `import-scoped`).
//
// Fixes: `.chain()` -> `.flatMap()` is a safe rewrite (method rename, no
// import churn). The free-function renames are unsafe fixes — they need the
// canonical name imported, which GritQL cannot add; run `--write --unsafe`
// and fix the import, or use `@onrails/codemod`, which rewrites both.

engine biome(1.0)
language js(typescript)

or {
  `$x.chain($args)` => `$x.flatMap($args)`,
  `$x?.chain($args)` => `$x?.flatMap($args)`,
  `matchResult($args)` => `match($args)`,
  `matchMaybe($args)` => `match($args)`,
  `getOrElse($args)` => `unwrapOr($args)`,
  `collect($args)` => `combine($args)`,
  `sequenceTupleAsync($args)` => `ResultAsync.combineTuple($args)`,
  `fold($args)`,
  `of($args)`,
  `$x.isOk()`,
  `$x?.isOk()`,
  `$x.isErr()`,
  `$x?.isErr()`
} as $call where {
  $call <: within JsModule(items = $items),
  $items <: contains JsModuleSource() as $source,
  $source <: r".*@onrails/.*",
  or {
    { $call <: or { `$_.chain($_)`, `$_?.chain($_)` }, $kind = "safe" },
    { $kind = "unsafe" }
  },
  register_diagnostic(
    span = $call,
    message = "Avoid deprecated onrails synonyms/methods. Use the canonical equivalents instead.",
    severity = "error",
    fix_kind = $kind
  )
}
