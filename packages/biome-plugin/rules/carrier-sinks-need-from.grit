// @onrails/biome-plugin: carrier-sinks-need-from
//
// Flag `JSON.parse(…)`, `structuredClone(…)` and `….json()` output cast to
// `Result<…>` / `Maybe<…>`. Plain data from those sinks has no methods once
// carriers keep them on a prototype, so the cast lies. Lift with
// `Result.from` / `Maybe.from` instead.
//
// Limitation: matches the `as` cast form only. The ESLint rule also flags
// `const r: Result<…> = JSON.parse(…)`; GritQL cannot relate a declarator's
// annotation to its initializer. Declared in ENGINE_DIVERGENCES
// (`carrier-sinks-need-from` / `cast-form-only`).

engine biome(1.0)
language js

or {
  `$sink as Result<$a, $b>`,
  `$sink as Maybe<$a>`
} as $t where {
  $sink <: or {
    contains `JSON.parse($_)`,
    contains `structuredClone($_)`,
    contains `$_.json()`
  },
  register_diagnostic(
    span = $t,
    message = "Data from JSON.parse/structuredClone/.json() is typed as Result/Maybe but carries no methods — lift it with Result.from / Maybe.from.",
    severity = "error"
  )
}
