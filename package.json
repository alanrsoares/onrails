{
  "name": "onrails",
  "private": true,
  "type": "module",
  "description": "Tagged Result / ResultAsync + railway-oriented utilities for TypeScript",
  "license": "MIT",
  "author": "Alan R. Soares",
  "homepage": "https://github.com/alanrsoares/onrails#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanrsoares/onrails.git"
  },
  "bugs": {
    "url": "https://github.com/alanrsoares/onrails/issues"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "@biomejs/biome": "^2.5.12",
      "@types/bun": "latest",
      "fast-check": "^4.9.0",
      "ts-expect": "^1.3.0",
      "tsup": "^8.5.1",
      "typescript": "^7.0.2",
      "typescript6": "npm:typescript@^6.0.3"
    }
  },
  "engines": {
    "bun": ">=1.0"
  },
  "scripts": {
    "typecheck": "bun run --filter '@onrails/*' typecheck",
    "build": "bun run build:base && bun run build:dependents",
    "build:base": "bun run --filter '@onrails/result' build",
    "build:dependents": "bun run --filter '@onrails/maybe' --filter '@onrails/pattern' --filter '@onrails/twoslash' build && bun run --filter '@onrails/docgen' build",
    "clean": "bun run --filter './packages/*' clean",
    "check:packaging": "bun run scripts/check-packaging.ts",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write . --error-on-warnings",
    "format": "biome format --write .",
    "test": "bun run --filter '@onrails/*' test",
    "check:loc": "bun run scripts/check-loc.ts",
    "check:examples": "bun run scripts/check-api-examples.ts",
    "check": "bun run check:loc && bun run lint && bun run build && bun run typecheck && bun run check:examples && bun run test && bun run check:packaging",
    "docs": "bun run --filter '@onrails/docs' dev",
    "docs:build": "bun run --filter '@onrails/docs' build",
    "docs:generate": "bun run scripts/generate-api-docs.ts",
    "prepare": "husky"
  },
  "overrides": {
    "@types/hast": "^3.0.5",
    "shiki": "^4.4.3",
    "@shikijs/types": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@onrails/docgen": "workspace:*",
    "@onrails/result": "workspace:*",
    "@tanstack/intent": "^0.3.6",
    "@types/bun": "catalog:",
    "husky": "^9.1.7",
    "publint": "0.3.23",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript6": "catalog:"
  }
}
